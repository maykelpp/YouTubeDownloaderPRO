# Copia este archivo a .env para desarrollo local (NUNCA subas .env a GitHub)

# --- Núcleo ---
SECRET_KEY=
FLASK_ENV=production
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=true

# --- Base de datos ---
# Por defecto usa SQLite en /tmp (efímero en Render). Para persistencia real
# usa un DATABASE_URL de PostgreSQL, p.ej.:
# DATABASE_URL=postgresql://usuario:password@host:5432/dbname
DATABASE_URL=sqlite:////tmp/app.db

# --- SMTP (correo de verificación y 2FA) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
SUPPORT_EMAIL=dcpiurl@gmail.com

# --- Cuenta administrativa inicial ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Keepalive (opcional) ---
ENABLE_KEEPALIVE=false
KEEPALIVE_URL=
KEEPALIVE_INTERVAL=30
